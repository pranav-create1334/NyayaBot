# NyayaBot environment configuration (placeholders only).
# Copy this file to .env.local at the project root and fill in your real values.
# .env.local is loaded by the Express backend and is git-ignored.

# Google Gemini API key (required) — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_actual_api_key_here

# Gemini model to use (must be available to your API key)
GEMINI_MODEL=gemini-2.5-flash

# Optional overrides
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
